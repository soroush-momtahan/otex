@using Otex.Micros.Identity.Razor.Features.SignOn.Enums
@model SignOn

<div class="flex flex-col gap-4 mb-6">
    <input asp-for="@Model.InputModel.Password" bind type="password" dir="ltr" placeholder="رمز عبور"
           class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:border-blue-500 transition-all shadow-sm"/>

    @if (!Model.ViewModel.IsExistingUser)
    {
        <input asp-for="@Model.InputModel.ConfirmPassword" bind type="password" dir="ltr" placeholder="تکرار رمز عبور"
               class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:border-blue-500 transition-all shadow-sm"/>
    }
</div>

<div class="flex gap-2">
    <!-- دکمه Back با value مشخص، به سرور می‌فهماند که به جای اعتبارسنجی، یک مرحله به عقب برگردد disabled:opacity-60 disabled:cursor-not-allowed -->
    <button type="button"
            on:click="@(() => Model.BackStep())"
            class="w-1/3 h-14 md:h-16 bg-gray-200 text-gray-700 font-bold rounded-2xl active:scale-95">
        <span class="normal-state">برگشت</span>
        <div class="loading-state hidden items-center justify-center gap-1">
            <div class="size-6 border-4 border-white/30 border-t-gray-300 rounded-full animate-spin"></div>
        </div>
    </button>
    <button type="submit" name="action" value="next"
            class="w-2/3 h-14 md:h-16 bg-[#0A102E] text-white font-bold rounded-2xl shadow-lg">
        <span class="normal-state">@(Model.ViewModel.IsExistingUser ? "ورود به حساب" : "تایید رمز")</span>
        <div class="loading-state hidden items-center justify-center gap-1">
            <span class="">@(Model.ViewModel.IsExistingUser ? "ورود به حساب" : "تایید رمز")</span>
            <div class="size-6 border-4 border-white/30 border-t-gray-300 rounded-full animate-spin"></div>
        </div>
    </button>
</div>