@model SignOn

<div class="mb-6">
    <!-- استفاده از name="Mobile" به جای asp-for تا مستقیما به InputModel بایند شود -->
    <input asp-for="@Model.InputModel.Mobile" bind:blur dir="ltr" placeholder="0912 345 6789"
           class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center tracking-widest focus:border-blue-500 transition-all shadow-sm"/>
</div>
            
<!-- دکمه پیش‌فرض فرم را سابمیت می‌کند (action = next) -->
<button type="submit" name="action" value="next"
        class="btn w-full h-14 md:h-16 bg-[#0A102E] text-white font-bold rounded-2xl transition-all shadow-lg active:scale-95">
    <span class="normal-state">ادامه</span>
    <div class="loading-state hidden items-center justify-center gap-1">
        <span>در حال بررسی شماره...</span>
        <div class="size-6 border-4 border-white/30 border-t-gray-300 rounded-full animate-spin"></div>
    </div>
</button>