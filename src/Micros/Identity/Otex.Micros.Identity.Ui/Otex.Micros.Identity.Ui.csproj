<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Otex.Micros.Identity.Infrastructure\Otex.Micros.Identity.Infrastructure.csproj" />
      <ProjectReference Include="..\..\..\BuildingBlocks\Otex.BuildingBlocks.Razor\Otex.BuildingBlocks.Razor.csproj"/>  
    </ItemGroup>

    <ItemGroup>
        <!-- ۱. حذف از سیستم داخلی دات‌نت برای جلوگیری از خطای BLAZOR106 -->
        <Content Remove="Pages/**/*.cshtml.js" />

        <!-- ۲. تعریف فایل‌ها در یک گروه اختصاصی -->
        <PageScripts Include="Pages/**/*.cshtml.js" />
    </ItemGroup>

    <Target Name="CopyPageScripts" BeforeTargets="Build">
        <!-- ۳. کپی هوشمند با تغییر نام در لحظه (Transform) -->
        <Copy SourceFiles="@(PageScripts)"
              DestinationFiles="@(PageScripts->'wwwroot/js/pages/%(RecursiveDir)%(Filename)%(Extension)'->Replace('.cshtml.js', '.js'))"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CleanPageScripts" AfterTargets="Clean">
        <RemoveDir Directories="wwwroot/js/pages" />
    </Target>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\js\site.js" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\appsettings.Development.json" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\appsettings.json" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\index.cshtml.css" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\package-lock.json" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\package.json" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\Account\Login\Index.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\Error.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\Index.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\Privacy.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\Shared\_Layout.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\Shared\_ValidationScriptsPartial.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\_ViewImports.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Pages\_ViewStart.cshtml" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\_Layout.cshtml.css" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Account\Login\index.cshtml.js" />
      <_ContentIncludedByDefault Remove="wwwroot\js\pages\Account\Login\index.js" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Features\Products\Components\TestAlpine\" />
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

</Project>
