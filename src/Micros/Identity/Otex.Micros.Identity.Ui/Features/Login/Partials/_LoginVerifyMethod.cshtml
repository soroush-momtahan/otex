@using Otex.Micros.Identity.Ui.Features.Login.Enums
@model LoginViewModel

<div x-data="{ show: false }" x-init="setTimeout(() => show = true, 50)" class="flex flex-col gap-4 mb-6">
    
    <!-- کارت ورود با رمز عبور -->
    <button type="submit" name="Action" value="@SignOnAction.PasswordVerifyMethod"
            x-show="show"
            x-transition:enter="transition-all duration-500 ease-out"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="group relative flex items-center justify-between w-full h-auto p-4 md:p-5 bg-white border border-gray-200 rounded-2xl transition-all duration-300 hover:border-blue-500 hover:shadow-[0_8px_30px_rgb(10,16,46,0.08)] hover:-translate-y-1 active:scale-95 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 overflow-hidden">
        
        <div class="flex items-center gap-4 relative z-10">
            <!-- باکس آیکون که در هاور به رنگ دکمه‌های اصلی شما (#0A102E) در می‌آید -->
            <div class="flex items-center justify-center w-12 h-12 md:w-14 md:h-14 bg-gray-50 text-gray-500 border border-gray-100 rounded-xl group-hover:bg-[#0A102E] group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
            </div>
            <div class="text-right">
                <h3 class="text-base md:text-lg font-black text-gray-800 transition-colors duration-300">ورود با رمز عبور</h3>
                <p class="text-xs md:text-sm text-gray-500 mt-1">استفاده از کلمه عبور ثابت</p>
            </div>
        </div>
        
        <div class="text-gray-300 group-hover:text-[#0A102E] group-hover:-translate-x-1 transition-all duration-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
        </div>
    </button>

    <!-- کارت دریافت کد تایید -->
    <button type="submit" name="Action" value="@SignOnAction.OtpVerifyMethod"
            x-show="show"
            x-transition:enter="transition-all duration-500 delay-100 ease-out"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            class="group relative flex items-center justify-between w-full h-auto p-4 md:p-5 bg-white border border-gray-200 rounded-2xl transition-all duration-300 hover:border-blue-500 hover:shadow-[0_8px_30px_rgb(10,16,46,0.08)] hover:-translate-y-1 active:scale-95 focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 overflow-hidden">
        
        <div class="flex items-center gap-4 relative z-10">
            <div class="flex items-center justify-center w-12 h-12 md:w-14 md:h-14 bg-gray-50 text-gray-500 border border-gray-100 rounded-xl group-hover:bg-[#0A102E] group-hover:text-white transition-all duration-300 shadow-sm">
                <svg class="w-6 h-6 md:w-7 md:h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
            </div>
            <div class="text-right">
                <h3 class="text-base md:text-lg font-black text-gray-800 transition-colors duration-300">دریافت کد تایید</h3>
                <p class="text-xs md:text-sm text-gray-500 mt-1 dir-ltr inline-block">@Model.Input.Mobile</p>
                <span class="text-xs md:text-sm text-gray-500 mt-1">ارسال پیامک به</span>
            </div>
        </div>
        
        <div class="text-gray-300 group-hover:text-[#0A102E] group-hover:-translate-x-1 transition-all duration-300">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
        </div>
    </button>
</div>

<div class="flex justify-center mt-2">
    <button type="submit" formnovalidate name="Action" value="@SignOnAction.Back"
            class="h-14 px-6 text-gray-500 font-bold rounded-2xl hover:bg-gray-100 hover:text-gray-800 transition-all active:scale-95">
        اصلاح شماره موبایل
    </button>
</div>