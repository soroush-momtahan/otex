@using Otex.Micros.Identity.Ui.Features.Login.Enums
@model LoginViewModel

<div class="flex flex-col gap-4 mb-6">
    <input name="@nameof(Model.Input.Password)" type="password" dir="ltr" placeholder="رمز عبور"
           class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:border-blue-500 transition-all shadow-sm"/>

    @if (!Model.Input.IsExistingUser)
    {
        <input name="@nameof(Model.Input.ConfirmPassword)" type="password" dir="ltr" placeholder="تکرار رمز عبور"
               class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:border-blue-500 transition-all shadow-sm"/>
    }
</div>

<div class="flex gap-2">
    <!-- دکمه Back با value مشخص، به سرور می‌فهماند که به جای اعتبارسنجی، یک مرحله به عقب برگردد -->
    <button type="submit" formnovalidate name="action" value="@SignOnAction.Back"
            class="w-1/3 h-14 md:h-16 bg-gray-200 text-gray-700 font-bold rounded-2xl active:scale-95">
        برگشت
    </button>
    <button type="submit" name="action" value="next"
            class="w-2/3 h-14 md:h-16 bg-[#0A102E] text-white font-bold rounded-2xl shadow-lg">
        @(Model.Input.IsExistingUser ? "ورود به حساب" : "تایید رمز")
    </button>
</div>