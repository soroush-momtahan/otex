@page
@model Otex.Micros.Identity.Api.Pages.Account.Login.Index
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="htmx-config" content='{"includeIndicatorStyles": false}'>
    <title>ورود | فروشگاه لنت اتکس</title>
    <link href="~/css/app.css" rel="stylesheet"/>
</head>
<body id="main-bg" class="bg-violet-600 transition-colors duration-1000 ease-in-out min-h-dvh flex justify-center items-center font-anjoman p-0 md:p-6">

    <div class="relative w-full h-[100dvh] md:h-[90vh] md:max-h-[650px] max-w-md md:max-w-5xl flex flex-col md:flex-row shadow-2xl overflow-hidden md:rounded-3xl bg-white/5 backdrop-blur-sm">

        <!-- پس زمینه و اسلایدر -->
        <div class="absolute bottom-[35%] md:bottom-0 start-0 md:w-[calc(100%-400px)] lg:md:w-[calc(100%-450px)] opacity-20 pointer-events-none z-0">
            <img src="~/images/silhouette-02.png" class="w-full h-auto object-cover md:object-contain object-bottom"/>
        </div>

        <div class="flex-1 flex flex-col pt-4 md:pt-8 px-4 md:px-8 relative z-10 justify-between md:justify-start">
            <div class="flex gap-1.5 mb-8 md:mb-12" id="progress-container"></div>
            <div id="slide-content" class="flex flex-col items-center text-center text-white animate-fade-in-up mt-auto md:mt-10 mb-auto">
                <h1 id="slide-title" class="text-xl md:text-3xl font-black mb-3 md:mb-5 drop-shadow-md">خرید لذت بخش لنت</h1>
                <p id="slide-desc" class="text-sm md:text-base opacity-90 drop-shadow-sm px-4 md:px-10">با چند لمس لنت خود را سفارش دهید...</p>
                <div class="mt-8 md:mt-12 relative w-48 h-48 md:w-72 md:h-72 flex justify-center items-center">
                    <img id="slide-image" src="~/images/slide-00.png" class="w-full h-full scale-200 md:scale-100 lg:scale-150 object-contain transition-transform hover:scale-y-150"/>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- بخش فرم -->
        <!-- ========================================== -->
        <div class="bg-gradient-to-t from-[#F8F9FA] to-[#F8F9FA]/65 w-full md:w-[400px] lg:w-[450px] shrink-0 rounded-t-3xl md:rounded-none px-6 md:px-10 pt-8 md:pt-12 pb-10 relative z-20 shadow-2xl flex flex-col justify-center">

            <form id="multi-step-form" method="post"
                  hx-select="#multi-step-form"
                  hx-target="#multi-step-form"
                  hx-swap="outerHTML">

                <!-- حفظ وضعیت سیستم -->
                <input type="hidden" asp-for="Input.ReturnUrl"/>
                <input type="hidden" asp-for="CurrentStep"/>
                <input type="hidden" asp-for="IsExistingUser"/>

                <!-- حفظ داده های تایپ شده در مراحل قبلی -->
                @if (Model.CurrentStep > 1) { <input type="hidden" asp-for="Input.Username" /> }
                @if (Model.CurrentStep > 2) {
                    <input type="hidden" asp-for="Input.Password" />
                    <input type="hidden" asp-for="Input.ConfirmPassword" />
                }

                <div id="auth-form-content" class="relative min-h-[220px] md:min-h-[250px]">

                    <div class="text-center mb-4 md:mb-6">
                        @if(Model.CurrentStep == 1) {
                            <h2 class="text-2xl md:text-3xl font-black text-gray-800">خوش آمدید!</h2>
                            <p class="text-xs md:text-sm text-gray-500 mt-2">جهت شروع، شماره موبایل خود را وارد کنید.</p>
                        } else if(Model.CurrentStep == 2) {
                            <h2 class="text-2xl md:text-3xl font-black text-gray-800">@(Model.IsExistingUser ? "خوش برگشتید" : "امنیت حساب")</h2>
                            <p class="text-xs md:text-sm text-gray-500 mt-2">@(Model.IsExistingUser ? "لطفاً رمز عبور خود را وارد کنید." : "لطفاً رمز عبور جدیدی تعیین کنید.")</p>
                        } else {
                            <h2 class="text-2xl md:text-3xl font-black text-gray-800">قدم آخر</h2>
                            <p class="text-xs md:text-sm text-gray-500 mt-2">نام خود را برای تکمیل پروفایل وارد کنید.</p>
                        }
                    </div>

                    <!-- انیمیشن ارورها -->
                    <div id="error-container" class="grid transition-all duration-500 ease-in-out @(ModelState.ErrorCount > 0 ? "grid-rows-[1fr] opacity-100 mb-4" : "grid-rows-[0fr] opacity-0 mb-0")">
                        <div class="overflow-hidden">
                            <div asp-validation-summary="All" class="text-rose-500 text-sm font-bold text-center"></div>
                        </div>
                    </div>

                    <!-- مرحله ۱ -->
                    @if (Model.CurrentStep == 1)
                    {
                        <div class="mb-6">
                            <input asp-for="Input.Username" type="tel" dir="ltr" placeholder="0912 345 6789" class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center text-lg tracking-widest focus:outline-none focus:border-blue-500 transition-all bg-white shadow-sm"/>
                        </div>
                        <button type="submit" hx-post="?handler=Step1" class="w-full h-14 md:h-16 bg-[#0A102E] hover:bg-[#141b3d] text-white font-bold rounded-2xl transition-all shadow-lg active:scale-95">
                            تایید شماره و ادامه
                        </button>
                    }

                    <!-- مرحله ۲ -->
                    @if (Model.CurrentStep == 2)
                    {
                        <div class="flex flex-col gap-4 mb-6">
                            <input asp-for="Input.Password" type="password" dir="ltr" placeholder="رمز عبور" class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:outline-none focus:border-blue-500 transition-all bg-white shadow-sm"/>

                            @if (!Model.IsExistingUser)
                            {
                                <input asp-for="Input.ConfirmPassword" type="password" dir="ltr" placeholder="تکرار رمز عبور" class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:outline-none focus:border-blue-500 transition-all bg-white shadow-sm"/>
                            }
                        </div>

                        <div class="flex gap-2">
                            <button type="button" hx-post="?handler=Back&targetStep=1" class="w-1/3 h-14 md:h-16 bg-gray-200 text-gray-700 font-bold rounded-2xl hover:bg-gray-300 transition-all active:scale-95">
                                برگشت
                            </button>

                            <button type="submit" hx-post="?handler=Step2" class="w-2/3 h-14 md:h-16 bg-[#0A102E] text-white font-bold rounded-2xl shadow-lg">
                                @(Model.IsExistingUser ? "ورود به حساب" : "تایید رمز")
                            </button>
                        </div>
                    }

                    <!-- مرحله ۳ -->
                    @if (Model.CurrentStep == 3)
                    {
                        <div class="flex flex-col gap-4 mb-6">
                            <input asp-for="Input.FirstName" type="text" placeholder="نام" class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:outline-none focus:border-blue-500 transition-all bg-white shadow-sm"/>
                            <input asp-for="Input.LastName" type="text" placeholder="نام خانوادگی" class="w-full h-14 md:h-16 border border-gray-200 rounded-2xl px-4 text-center focus:outline-none focus:border-blue-500 transition-all bg-white shadow-sm"/>
                        </div>

                        <div class="flex gap-2">
                            <button type="button" hx-post="?handler=Back&targetStep=2" class="w-1/3 h-14 md:h-16 bg-gray-200 text-gray-700 font-bold rounded-2xl hover:bg-gray-300 transition-all active:scale-95">
                                برگشت
                            </button>

                            <button type="submit" hx-post="?handler=Step3" class="w-2/3 h-14 md:h-16 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl shadow-lg">تکمیل و ورود</button>
                        </div>
                    }

                </div>
            </form>

            <div class="flex justify-between items-center mt-auto md:mt-8 pt-6 border-t border-gray-200 text-xs md:text-sm font-bold text-blue-600">
                <a href="#" class="hover:underline">شرایط استفاده از اتکس</a>
                <a href="#" class="hover:underline">کد معرف دارید؟</a>
            </div>
        </div>
    </div>

    <script src="~/js/login-slider.js"></script>
    <script src="~/js/htmx.min.js"></script>
</body>
</html>
